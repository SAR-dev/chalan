{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "src/**/*.{ts,tsx,js,jsx,mjs,cjs}",
      "e2e/**/*.{ts,tsx,js,jsx}",
      "env/**/*.{ts,tsx,js,jsx}",
      "scripts/**/*.{ts,tsx,js,jsx}"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noThenProperty": "off",
        "noImplicitAnyLet": "off",
        "noShadowRestrictedNames": "off",
        "noGlobalIsNan": "off",
        "useIterableCallbackReturn": "off"
      },
      "complexity": {
        "useOptionalChain": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "error",
        "useValidAriaRole": "error",
        "noLabelWithoutControl": "error",
        "noAutofocus": "error",
        "useButtonType": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["*.css"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    }
  ]
}
