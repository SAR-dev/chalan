# Dockerfile — PostgreSQL 17 with pg_stat_statements + pg_cron
#
# Extends the official postgres:17 image with pg_cron (not bundled by default).
# pg_stat_statements is already included in the official image.
#
# Usage:
#   docker compose up -d --build

FROM postgres:17

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        postgresql-server-dev-17 \
    && rm -rf /var/lib/apt/lists/*

# pg_cron — built from source (not bundled in official image)
RUN curl -fsSL "https://github.com/citusdata/pg_cron/archive/refs/tags/v1.6.4.tar.gz" \
    | tar xz -C /tmp \
    && cd /tmp/pg_cron-1.6.4 \
    && make -j$(nproc) PG_CONFIG=/usr/bin/pg_config \
    && make install PG_CONFIG=/usr/bin/pg_config \
    && cd / && rm -rf /tmp/pg_cron-1.6.4

# Cleanup build dependencies
RUN apt-get purge -y --auto-remove build-essential git curl \
    && rm -rf /var/lib/apt/lists/*
