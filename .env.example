# Copy this file to .env and fill in your values
# See docs/ENV.md for detailed documentation of each variable

# Business timezone (ROADMAP P1.3). Day-bucketed reports and "today" filters
# use Asia/Dhaka; this pins the container's clock so Node and the database
# agree with the app. Asia/Dhaka is a fixed UTC+6 offset (no DST).
TZ=Asia/Dhaka

DATABASE_URL=postgres://postgres:admin@localhost:5432/delivery
DATABASE_URL_READ_ONLY=

# AES-256-GCM key for encrypting SMTP password at rest (64 hex chars = 32
# bytes). REQUIRED in production — without it, mail-config falls back to a
# hardcoded development key.
# Generate with: openssl rand -hex 32
# SMTP_SECRET_KEY=

# Auth signing key — REQUIRED, at least 32 characters (boot validation rejects
# shorter values). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-random-32-plus-char-secret
BETTER_AUTH_ALLOWED_URLS=http://localhost:3000

# Optional — absolute base URL for auth API calls made from the browser. Leave
# unset to use the current origin (same-origin deployments). Set it when the
# frontend and API are served from different origins.
# NEXT_PUBLIC_BASE_URL=

STORAGE_PROVIDER=local
LOCAL_UPLOADS_DIR=./.uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

CRON_SECRET=xxxxxx
AUDIT_LOG_RETENTION_DAYS=30
EMAIL_LOG_RETENTION_DAYS=10

# Optional — grace period (hours) before /api/cron/cleanup-uploads may delete
# an upload no DB row references (default 48 — ImageUpload uploads on file
# select, before the form is submitted). See docs/ENV.md → Cron.
# UPLOAD_SWEEP_MIN_AGE_HOURS=48

# Optional — Redis for cross-instance rate limiting (see S6). When unset, the
# rate limiter falls back to an in-memory store (fine for single-instance dev).
# In production an unset REDIS_URL is reported as degraded on /api/health:
# limits are then per-instance and a multi-instance deploy can be bypassed.
# REDIS_URL=redis://localhost:6379

# Optional — how many reverse-proxy hops sit in front of the app. Forwarding
# headers (x-forwarded-for / x-real-ip / cf-connecting-ip) are ONLY trusted
# when this is set: the client IP is read from the entry the last trusted hop
# appended, so a client cannot forge a fresh rate-limit bucket — and cannot
# forge its way past ADMIN_IP_ALLOWLIST. Unset/0 = no proxy, headers ignored.
# Single nginx in front: 1. Cloudflare + nginx: 2. See docs/ENV.md → Security.
# TRUSTED_PROXY_HOPS=1

# Optional — restrict the admin portal (/dashboard + /api/admin) to a
# comma-separated list of IPs/CIDRs (e.g. 203.0.113.5,10.0.0.0/8,::1).
# Unset or empty = disabled. Requires TRUSTED_PROXY_HOPS to be set: the app
# must be behind a proxy that overwrites the forwarding headers, otherwise
# every request looks like it comes from an unknown address and is denied.
# See docs/ENV.md → Security.
# ADMIN_IP_ALLOWLIST=

# Optional — "1" makes 2FA mandatory for admin roles (deployment policy;
# changing it needs a restart). Unset/0 = optional; merchants and riders can
# always opt in themselves. See docs/ENV.md → Security.
# ADMIN_2FA_REQUIRED=

CLOUDFLARE_TUNNEL_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development

MAIL_DISABLED=
AUTH_RATE_LIMIT_DISABLED=
PLAYWRIGHT_BASE_URL=http://localhost:3000

POSTGRESQL_POSTGRES_PASSWORD=
POSTGRESQL_USERNAME=
POSTGRESQL_PASSWORD=
POSTGRESQL_DATABASE=
REPMGR_PASSWORD=
PGPOOL_ADMIN_PASSWORD=

DASHBOARD_URL=
MERCHANT_URL=
RIDER_URL=
WAREHOUSE_URL=
ALLOWED_ROLE=

# Optional — which portals this deployment serves (server-only; changing it
# needs a restart): admin = dashboard+warehouse, public = merchant+rider,
# all = everything. Unset = all. See docs/ENV.md → Deployment (portal modes).
# PORTAL_MODE=all

# Optional — password for every account created by `pnpm db:seed:full`.
# Unset = the documented dev/e2e password (12qwaszx). Both seed entrypoints
# refuse to run when NODE_ENV=production and this is unset, so a production
# database can never be seeded on a published password. See docs/ENV.md.
# SEED_PASSWORD=

