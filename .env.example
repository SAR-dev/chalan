# Copy this file to .env and fill in your values
# See docs/ENV.md for detailed documentation of each variable

DATABASE_URL=postgres://postgres:admin@localhost:5432/delivery
DATABASE_URL_READ_ONLY=

# AES-256-GCM key for encrypting SMTP password at rest (64 hex chars = 32
# bytes). REQUIRED in production — without it, mail-config falls back to a
# hardcoded development key.
# Generate with: openssl rand -hex 32
# SMTP_SECRET_KEY=

BETTER_AUTH_SECRET=xxxxxxxxxx
BETTER_AUTH_ALLOWED_URLS=http://localhost:3000

STORAGE_PROVIDER=local
LOCAL_UPLOADS_DIR=./.uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
SUPABASE_PUBLIC_URL=

CRON_SECRET=xxxxxx
AUDIT_LOG_RETENTION_DAYS=30
EMAIL_LOG_RETENTION_DAYS=10

# Optional — Redis for cross-instance rate limiting (see S6). When unset, the
# rate limiter falls back to an in-memory store (fine for single-instance dev).
# REDIS_URL=redis://localhost:6379

CLOUDFLARE_TUNNEL_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development

MAIL_DISABLED=
AUTH_RATE_LIMIT_DISABLED=
PLAYWRIGHT_BASE_URL=http://localhost:3000

POSTGRESQL_POSTGRES_PASSWORD=
POSTGRESQL_USERNAME=
POSTGRESQL_PASSWORD=
POSTGRESQL_DATABASE=
REPMGR_PASSWORD=
PGPOOL_ADMIN_PASSWORD=

DASHBOARD_URL=
MERCHANT_URL=
RIDER_URL=
WAREHOUSE_URL=
ALLOWED_ROLE=

# Optional — overrides the password of the three seeded SUPER_ADMIN accounts
# (admin01/02/03@email.com) created by the seed script. Leave unset for the
# documented local/e2e default (admin123); always set in real environments.
# SEED_SUPER_ADMIN_PASSWORD=
