# Copy this file to .env and fill in your values. See docs/ENV.md for details.

# Business timezone — day-bucketed reports and "today" filters use Asia/Dhaka (no DST).
TZ=Asia/Dhaka

DATABASE_URL=postgres://postgres:admin@localhost:5432/delivery

# Optional read replica for list/read queries.
DATABASE_URL_READ_ONLY=

# AES-256-GCM key for encrypting the SMTP password (64 hex chars). REQUIRED in production. Generate: openssl rand -hex 32
SMTP_SECRET_KEY=replace-me-with-a-random-64-hex-char-secret

# Auth signing key — REQUIRED, at least 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-random-32-plus-char-secret
# Comma-separated allowed auth callback origins (read by src/lib/auth.ts).
BETTER_AUTH_ALLOWED_URLS=http://localhost:3000

# Absolute base URL for browser-side auth API calls; unset = current origin.
# NEXT_PUBLIC_BASE_URL=

STORAGE_PROVIDER=local
LOCAL_UPLOADS_DIR=./.uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Shared secret authorising /api/cron endpoints (deployment-only).
CRON_SECRET=xxxxxx
AUDIT_LOG_RETENTION_DAYS=30
EMAIL_LOG_RETENTION_DAYS=10

# Min age (hours) for unreferenced uploads before /api/cron/cleanup-uploads may delete them (default 48).
UPLOAD_SWEEP_MIN_AGE_HOURS=48

# Redis for cross-instance rate limiting; unset = in-memory store (single-instance dev only).
# REDIS_URL=redis://localhost:6379

# Number of reverse-proxy hops in front of the app; unset/0 = forwarding headers ignored.
# TRUSTED_PROXY_HOPS=1

# Comma-separated IPs/CIDRs allowed into the admin portal; requires TRUSTED_PROXY_HOPS. Unset = disabled.
# ADMIN_IP_ALLOWLIST=

# "1" makes 2FA mandatory for admin roles.
# ADMIN_2FA_REQUIRED=

# Public site URL used to build absolute links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployment environment: development | production.
# "development" also enables seeded-demo mode (sign-in picker, demo banner,
# daily 12am DB reset) — never set it in production, it exposes seed accounts.
NEXT_PUBLIC_ENV=development

# "1" disables real SMTP sends in development (drafts mails as FAILED in the log).
MAIL_DISABLED=
# "1" logs the redacted email body on each send (off by default; customer content).
LOG_EMAIL_BODY=
# Structured log verbosity: debug | info | warn | error (default info).
# Every line is JSON — see src/lib/logger.ts.
LOG_LEVEL=
# "1" disables auth rate limiting for local testing.
AUTH_RATE_LIMIT_DISABLED=
# E2E base URL (Playwright webServer).
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Comma-separated roles this deployment serves; unset = all (read by src/proxy.ts).
ALLOWED_ROLE=

# Which portals this deployment serves: admin | public | all (read by additionalModules).
# PORTAL_MODE=all
