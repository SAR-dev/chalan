{
  "name": "delivery-management",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:unit:report": "vitest run --reporter=html",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run src/lib/db/integration.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:admin": "tsx scripts/setup.ts",
    "db:seed:basic": "tsx src/lib/db/seed/index-basic.ts",
    "db:seed:full": "tsx src/lib/db/seed/index-full.ts",
    "db:push:e2e": "dotenv -e .env.e2e -e .env -- drizzle-kit push",
    "db:migrate:e2e": "dotenv -e .env.e2e -e .env -- tsx src/lib/db/migrate.ts",
    "db:seed:e2e": "dotenv -e .env.e2e -e .env -- tsx src/lib/db/seed/index-full.ts",
    "ci:fix": "pnpm lint && pnpm format",
    "ci:check": "pnpm typecheck && pnpm lint:check && pnpm format:check",
    "ci:test": "pnpm test:unit:run && pnpm build && pnpm test:e2e",
    "bump-sw": "node scripts/bump-sw-version.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@base-ui/react": "^1.8.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/view": "^6.43.13",
    "@paralleldrive/cuid2": "^3.3.0",
    "@react-email/render": "^2.1.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vercel/analytics": "2.0.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compressorjs": "^1.4.0",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^10.0.13",
    "papaparse": "^5.7.0",
    "pg": "8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "^5.0.3",
    "dotenv": "^18.0.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "postcss": "8.5.28",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": "biome check --write --no-errors-on-unmatched"
  }
}
