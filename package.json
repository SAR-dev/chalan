{
  "name": "delivery-management",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:unit:report": "vitest run --reporter=html",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:admin": "tsx scripts/setup.ts",
    "ci:fix": "pnpm lint && pnpm format",
    "ci:check": "pnpm typecheck && pnpm lint:check && pnpm format:check",
    "ci:test": "pnpm test:unit:run && pnpm build && pnpm test:e2e",
    "bump-sw": "node scripts/bump-sw-version.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@base-ui/react": "^1.5.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/analytics": "1.6.1",
    "@vercel/og": "^0.11.1",
    "better-auth": "^1.6.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compressorjs": "^1.3.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "mjml": "^5.4.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^9.0.1",
    "pg": "8.21.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mjml": "^5.0.0",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.10",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.0.7",
    "postcss": "8.5.10",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "5.7.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,mdx}": "biome check --write --no-errors-on-unmatched",
    "*.{ts,tsx}": "tsc --noEmit --pretty"
  }
}
