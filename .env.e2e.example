# E2E overrides — copy this file to `.env.e2e` (gitignored).
#
# Only set what differs from your normal `.env`: the Playwright config loads
# `.env.e2e` into the runner and every child (webServer + test workers) inherits
# it, while anything omitted falls back to `.env`. Values already set in the
# shell always win.
#
# Run e2e:  pnpm build  &&  pnpm test:e2e

# Point e2e at a dedicated database so a run never wipes your dev data.
# Create + migrate it once (use migrate, not push — CI migrates, and a
# push-created DB has no ledger so `db:migrate` would refuse it):
#   createdb chalan_e2e
#   pnpm db:migrate:e2e
DATABASE_URL=postgres://postgres:admin@localhost:5432/chalan_e2e

# Keep the development label so dev-only guards stay relaxed.
NEXT_PUBLIC_ENV=development

# Do NOT set MAIL_DISABLED=1: specs read activation links out of `email_log`,
# so mail sends must keep being attempted.
